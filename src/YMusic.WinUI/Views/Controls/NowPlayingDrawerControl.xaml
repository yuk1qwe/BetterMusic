<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="YMusic.WinUI.Views.Controls.NowPlayingDrawerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    Visibility="Collapsed"
    mc:Ignorable="d">

    <Grid x:Name="RootDrawerGrid" Background="#0A0A0E">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DrawerTranslateTransform" Y="0" />
        </Grid.RenderTransform>

        <!-- 1. Ambient Background Layer (Apple Music / Yandex Music liquid glow) -->
        <Grid x:Name="AmbientLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- Scaled HD Album Art for deep ambient color glow (Two layers for true crossfade) -->
            <Image x:Name="AmbientGlowCurrent"
                   Stretch="UniformToFill"
                   Opacity="0.40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                </Image.RenderTransform>
            </Image>
            <Image x:Name="AmbientGlowNext"
                   Stretch="UniformToFill"
                   Opacity="0.0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
                </Image.RenderTransform>
            </Image>

            <!-- Radial Dark Vignette: Let the center-left cover glow radiate while edges stay deep and dark -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.25,0.45" RadiusX="0.85" RadiusY="0.85" GradientOrigin="0.25,0.45">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#700A0A0E" Offset="0.45" />
                        <GradientStop Color="#E007070A" Offset="0.82" />
                        <GradientStop Color="#F8050508" Offset="1.0" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Overall Dark Mask for pristine text contrast -->
            <Rectangle Fill="#55000000" />
        </Grid>

        <!-- 2. Main Layout Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Floating Glass Header Bar & Custom TitleBar Drag Region -->
                <RowDefinition Height="54" />
                <!-- Content Area: Left HD Cover & Full Player, Right Apple-style Lyrics -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Floating Glass Header Bar Visual Background (spans 100% width under caption buttons, non-interactive) -->
            <Border Grid.Row="0"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,0,0,1"
                    Background="#25000000"
                    IsHitTestVisible="False" />

            <!-- Floating Glass Header Bar & Custom TitleBar Drag Region (stops before window caption buttons) -->
            <Grid Grid.Row="0"
                  x:Name="HeaderBarGrid"
                  Margin="0,0,140,0"
                  Padding="20,0,8,0"
                  Background="Transparent"
                  PointerPressed="HeaderBarGrid_PointerPressed"
                  DoubleTapped="HeaderBarGrid_DoubleTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Collapse Button & Header Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.CloseNowPlayingDrawerCommand}"
                            Width="38"
                            Height="38"
                            Padding="0"
                            CornerRadius="19"
                            Background="#22FFFFFF"
                            BorderBrush="#25FFFFFF"
                            helpers:CursorHelper.UseHandCursor="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CollapseDrawerTooltip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE70D;" FontSize="16" Foreground="White" />
                    </Button>

                    <Border Background="#1CFFFFFF"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEC4F;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.NowPlayingDrawerHeader, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       CharacterSpacing="120"
                                       Foreground="#E0FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: "Sync lyrics" floating button when user scrolled away -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowSyncLyricsButton, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Command="{x:Bind ViewModel.ResumeAutoScrollCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="32"
                            Padding="14,2"
                            CornerRadius="16"
                            helpers:CursorHelper.UseHandCursor="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RecenterLyricsTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE895;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.SyncToCurrentLineText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Action Buttons (Album, Fullscreen, Collapse) - placed before the 140px window caption buttons area -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.OpenCurrentAlbumCommand}"
                            Width="38"
                            Height="38"
                            Padding="0"
                            CornerRadius="19"
                            Background="#20FFFFFF"
                            BorderBrush="#20FFFFFF"
                            helpers:CursorHelper.UseHandCursor="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ViewAlbumTooltip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="15" Foreground="White" />
                    </Button>

                    <Button Click="FullscreenButton_Click"
                            Width="38"
                            Height="38"
                            Padding="0"
                            CornerRadius="19"
                            Background="#20FFFFFF"
                            BorderBrush="#20FFFFFF"
                            helpers:CursorHelper.UseHandCursor="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FullscreenTooltip, Mode=OneWay}">
                        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="15" Foreground="White" />
                    </Button>

                    <Button Command="{x:Bind ViewModel.CloseNowPlayingDrawerCommand}"
                            Width="38"
                            Height="38"
                            Padding="0"
                            CornerRadius="19"
                            Background="#20FFFFFF"
                            BorderBrush="#20FFFFFF"
                            helpers:CursorHelper.UseHandCursor="True"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CollapseDrawerTooltip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE74B;" FontSize="14" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area: Left HD Cover & Player, Right Karaoke Lyrics -->
            <Grid Grid.Row="1" Margin="32,16,32,24">
                <Grid.ColumnDefinitions>
                    <!-- Left: HD Cover, Track Details & Controls -->
                    <ColumnDefinition Width="Auto" MinWidth="380" MaxWidth="580" />
                    <!-- Right: Large Karaoke Lyrics Stream -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: HD Cover & Full Player Controls (Apple Music / Yandex Music aesthetic) -->
                <Grid Grid.Column="0"
                      Padding="8,8,16,12"
                      VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Left">
                        <!-- HD Album Art with Apple-style rounded rect and ambient glow border -->
                        <Border x:Name="CoverContainer"
                                Width="340"
                                Height="340"
                                HorizontalAlignment="Left"
                                CornerRadius="18"
                                BorderThickness="1.5"
                                BorderBrush="#35FFFFFF"
                                Background="#1AFFFFFF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CoverScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;"
                                          FontSize="60"
                                          Foreground="#50FFFFFF"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Image x:Name="CoverImageCurrent"
                                       Source="{x:Bind ViewModel.HdCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill"
                                       Opacity="1.0" />
                                <Image x:Name="CoverImageNext"
                                       Stretch="UniformToFill"
                                       Opacity="0.0" />
                            </Grid>
                        </Border>

                        <!-- Track Title & Artists (Interactive: Title opens album, Artist opens artist card) -->
                        <StackPanel x:Name="TrackInfoPanel" Spacing="4" HorizontalAlignment="Left" Width="340">
                            <HyperlinkButton Command="{x:Bind ViewModel.OpenCurrentAlbumCommand}"
                                             Padding="0"
                                             Margin="0"
                                             HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Left"
                                             helpers:CursorHelper.UseHandCursor="True"
                                             ToolTipService.ToolTip="{x:Bind ViewModel.ViewAlbumTooltip, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           IsHitTestVisible="False" />
                            </HyperlinkButton>

                            <HyperlinkButton x:Name="DrawerArtistButton"
                                             Command="{x:Bind ViewModel.OpenCurrentArtistCommand}"
                                             CommandParameter="{x:Bind DrawerArtistButton}"
                                             Padding="0"
                                             Margin="0,2,0,0"
                                             HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Left"
                                             helpers:CursorHelper.UseHandCursor="True"
                                             ToolTipService.ToolTip="{x:Bind ViewModel.ArtistInfoTooltip, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.ArtistNames, Mode=OneWay}"
                                           FontSize="15"
                                           FontWeight="Medium"
                                           Foreground="#B5FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           IsHitTestVisible="False" />
                            </HyperlinkButton>
                        </StackPanel>

                        <!-- Like & Audio Quality Badges -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Button Command="{x:Bind ViewModel.ToggleLikeCommand}"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="#25FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.LikeTooltip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}"
                                          FontSize="16"
                                          Foreground="{x:Bind ViewModel.LikeBrush, Mode=OneWay}" />
                            </Button>

                            <!-- More Options / FckCensor Button -->
                            <Button Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="#25FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.FckOptionsTooltip, Mode=OneWay}">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="DrawerTrackOptionsFlyout" Opening="DrawerTrackOptionsFlyout_Opening">
                                        <!-- Start Wave by Track -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.StartTrackWaveMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.StartTrackWaveCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE93E;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- Play Next -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.PlayNextMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.PlayNextCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE892;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- Add to Queue -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.AddToQueueMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.AddToQueueCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEA37;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Dislike -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.DislikeMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.DislikeAndSkipCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="{x:Bind ViewModel.DislikeMenuGlyph, Mode=OneWay}" Foreground="#FF5555" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- Add to Playlist (Submenu) -->
                                        <MenuFlyoutSubItem x:Name="DrawerAddToPlaylistSubItem"
                                                           Text="{x:Bind ViewModel.AddToPlaylistMenuText, Mode=OneWay}"
                                                           Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutSubItem.Icon>
                                                <FontIcon Glyph="&#xE8F4;" />
                                            </MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="..." IsEnabled="False" />
                                        </MenuFlyoutSubItem>

                                        <!-- Share -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ShareMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.ShareTrackCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- Download to file -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.DownloadFileMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.DownloadTrackFileCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE896;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- Track details -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.TrackDetailsMenuText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.ShowTrackDetailsCommand}"
                                                        Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE946;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- When Replaced: Remove replacement -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.FckRemoveReplacementText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.RemoveCurrentTrackReplacementCommand}"
                                                        Visibility="{x:Bind ViewModel.IsCurrentTrackReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" Foreground="#FF5555" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        
                                        <!-- When Replaced: Change with another file -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.FckChooseAnotherFileText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.ReplaceCurrentTrackCommand}"
                                                        Visibility="{x:Bind ViewModel.IsCurrentTrackReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- When Not Replaced: Replace Track -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.FckReplaceTrackText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.ReplaceCurrentTrackCommand}"
                                                        Visibility="{x:Bind ViewModel.IsCurrentTrackReplaced, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <!-- When Not Replaced: Report Censorship -->
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.FckReportCensorshipText, Mode=OneWay}"
                                                        Command="{x:Bind ViewModel.ReportCurrentTrackCensorshipCommand}"
                                                        Visibility="{x:Bind ViewModel.CanReportCurrentTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7BA;" Foreground="#FFB900" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE712;" FontSize="16" Foreground="White" />
                            </Button>

                            <Border Height="28"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    Background="#20FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.QualityTooltip, Mode=OneWay}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.QualityBadge, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Border Height="28"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    Background="#20FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ViewModel.LyricsBadgeGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LyricsBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Lyrics Sync Timing Button with Flyout -->
                            <Button Height="28"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    Background="#20FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    Visibility="{x:Bind ViewModel.HasSyncedLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.LyricsSyncTooltip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LyricsOffsetBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Width="290" Spacing="12" Padding="4">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind ViewModel.LyricsSyncTitle, Mode=OneWay}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14" />
                                                <TextBlock Text="{x:Bind ViewModel.LyricsSyncDescription, Mode=OneWay}"
                                                           FontSize="11.5"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Current Offset Display Badge -->
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="8"
                                                    Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind ViewModel.LyricsSyncCurrentOffsetLabel, Mode=OneWay}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind ViewModel.LyricsOffsetFormattedText, Mode=OneWay}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Slider -->
                                            <Slider Minimum="-60.0"
                                                    Maximum="60.0"
                                                    StepFrequency="0.5"
                                                    SmallChange="0.5"
                                                    LargeChange="5.0"
                                                    Value="{x:Bind ViewModel.LyricsOffsetSeconds, Mode=TwoWay}"
                                                    helpers:CursorHelper.UseHandCursor="True" />

                                            <!-- Quick Step Buttons -->
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="-5 с"
                                                        Command="{x:Bind ViewModel.AdjustLyricsOffsetCommand}"
                                                        CommandParameter="-5.0"
                                                        HorizontalAlignment="Stretch"
                                                        Height="30"
                                                        Padding="0"
                                                        helpers:CursorHelper.UseHandCursor="True" />
                                                <Button Grid.Column="1"
                                                        Content="-0.5 с"
                                                        Command="{x:Bind ViewModel.AdjustLyricsOffsetCommand}"
                                                        CommandParameter="-0.5"
                                                        HorizontalAlignment="Stretch"
                                                        Height="30"
                                                        Padding="0"
                                                        helpers:CursorHelper.UseHandCursor="True" />
                                                <Button Grid.Column="2"
                                                        Content="+0.5 с"
                                                        Command="{x:Bind ViewModel.AdjustLyricsOffsetCommand}"
                                                        CommandParameter="0.5"
                                                        HorizontalAlignment="Stretch"
                                                        Height="30"
                                                        Padding="0"
                                                        helpers:CursorHelper.UseHandCursor="True" />
                                                <Button Grid.Column="3"
                                                        Content="+5 с"
                                                        Command="{x:Bind ViewModel.AdjustLyricsOffsetCommand}"
                                                        CommandParameter="5.0"
                                                        HorizontalAlignment="Stretch"
                                                        Height="30"
                                                        Padding="0"
                                                        helpers:CursorHelper.UseHandCursor="True" />
                                            </Grid>

                                            <!-- Reset Button -->
                                            <Button Content="{x:Bind ViewModel.LyricsSyncResetText, Mode=OneWay}"
                                                    Command="{x:Bind ViewModel.ResetLyricsOffsetCommand}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="32"
                                                    helpers:CursorHelper.UseHandCursor="True" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- FCK Replaced Pill in Drawer -->
                            <Border Height="28"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.FckBadgeTooltip, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.IsCurrentTrackReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <TextBlock Text="FCK" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Slopless AI Music Pill in Drawer -->
                            <Border Height="28"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    Background="#26EF4444"
                                    BorderBrush="#80EF4444"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CurrentTrack.AiTooltip, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.CurrentTrack.IsAiTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE99A;" FontSize="10" Foreground="#FFEF4444" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.AiBadgeLabel, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FFEF4444" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Seek Bar & Elapsed Time -->
                        <StackPanel Spacing="1" Width="340" HorizontalAlignment="Left">
                            <Slider x:Name="SeekSlider"
                                    Margin="0"
                                    Minimum="0"
                                    Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                                    ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                                    VerticalAlignment="Center" />
                            <Grid Margin="2,0,2,0">
                                <TextBlock Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="#85FFFFFF"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="#85FFFFFF"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Playback Controls (Shuffle, Previous, Play/Pause, Next, Repeat) -->
                        <Grid Width="340" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="12">
                            <!-- Shuffle -->
                            <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleTooltip, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8B1;"
                                          FontSize="16"
                                          Foreground="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}" />
                            </Button>

                            <!-- Previous -->
                            <Button Command="{x:Bind ViewModel.PreviousCommand}"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    CornerRadius="19"
                                    Background="#20FFFFFF"
                                    BorderBrush="Transparent"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PreviousTooltip, Mode=OneWay}">
                                <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="White" />
                            </Button>

                            <!-- Play / Pause (Large 50px Apple Style Circular Button) -->
                            <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                                    Width="50"
                                    Height="50"
                                    Padding="0"
                                    CornerRadius="25"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                          FontSize="20"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Button>

                            <!-- Next -->
                            <Button Command="{x:Bind ViewModel.NextCommand}"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    CornerRadius="19"
                                    Background="#20FFFFFF"
                                    BorderBrush="Transparent"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.NextTooltip, Mode=OneWay}">
                                <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="White" />
                            </Button>

                            <!-- Repeat -->
                            <Button Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.RepeatTooltip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}"
                                          FontSize="16"
                                          Foreground="{x:Bind ViewModel.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatToAccentBrushConverter}}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                        <!-- Volume Slider Row -->
                        <Grid Width="340" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <StackPanel x:Name="DrawerVolumeContainer"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="6">
                                <Button Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.MuteTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="14" Foreground="#B0FFFFFF" />
                                </Button>

                                <Slider x:Name="DrawerVolumeSlider"
                                        Width="150"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        SmallChange="2"
                                        LargeChange="5"
                                        IsThumbToolTipEnabled="False"
                                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.VolumeTooltip, Mode=OneWay}" />

                                <!-- Interactive Volume Percentage (Clean TextBlock, turns into compact editor on click) -->
                                <Grid Width="38" Height="24" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <Border x:Name="DrawerVolumePercentageBadge"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            Padding="2,2"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.VolumeInputTooltip, Mode=OneWay}"
                                            PointerPressed="DrawerVolumePercentageBadge_PointerPressed">
                                        <TextBlock x:Name="DrawerVolumePercentageLabel"
                                                   Text="{x:Bind ViewModel.VolumePercentageText, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C8FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBox x:Name="DrawerVolumePercentageBox"
                                             Width="38"
                                             Height="24"
                                             MinHeight="0"
                                             Padding="0"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             TextAlignment="Center"
                                             CornerRadius="4"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"
                                             LostFocus="DrawerVolumePercentageBox_LostFocus"
                                             KeyDown="DrawerVolumePercentageBox_KeyDown" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Right Column: Apple Music / Yandex Music Karaoke Stream -->
                <Grid Grid.Column="1" Margin="24,0,24,0">
                    <!-- Loading lyrics state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="20"
                                Visibility="{x:Bind ViewModel.IsLoadingLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Border Width="72"
                                    Height="72"
                                    CornerRadius="36"
                                    Background="#14FFFFFF"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingLyrics, Mode=OneWay}"
                                          Width="44"
                                          Height="44"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.LoadingLyricsTitle, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#E0FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.LoadingLyricsSubtitle, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="#70FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- No lyrics state -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16"
                                Visibility="{x:Bind ViewModel.ShowNoLyricsPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="80"
                                Height="80"
                                CornerRadius="40"
                                Background="#14FFFFFF"
                                BorderBrush="#1EFFFFFF"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xEC4F;"
                                      FontSize="34"
                                      Foreground="#60FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.LyricsStatusText, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#E0FFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EnjoyTheMusicText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="#70FFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Synchronized Karaoke Lyrics List (Apple Music style) -->
                    <controls:ObservableListView x:Name="LyricsListView"
                                                 ItemsSource="{x:Bind ViewModel.Lyrics}"
                                                 SelectionMode="None"
                                                 IsItemClickEnabled="True"
                                                 ItemClick="LyricsListView_ItemClick"
                                                 Padding="20,240,40,340"
                                                 Visibility="{x:Bind ViewModel.HasLyrics, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <controls:ObservableListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,8" />
                                <Setter Property="CornerRadius" Value="14" />
                            </Style>
                        </controls:ObservableListView.ItemContainerStyle>

                        <controls:ObservableListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LyricLine">
                                <controls:LyricLineControl Line="{x:Bind}" />
                            </DataTemplate>
                        </controls:ObservableListView.ItemTemplate>
                    </controls:ObservableListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
